{
  "name": "hermes",
  "version": "1.0.0",
  "description": "Socket.IO server application",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "test": "npm run test:relay && npm run test:collab",
    "test:relay": "cd tests && node --test",
    "test:collab": "npm --prefix collab install --no-audit --no-fund && npm --prefix collab test"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.3"
  }
}
